; TODO: sidecondition
(declare-rule onepoint ((ctx @Context) (xs @VarList) (ys @VarList) (Q (-> @VarList Bool Bool)) (T Type) (phi T) (phi' T))
  :assumption ctx
  :premises ((cl (= phi phi')))
  :args (((cl (= (Q xs phi) (Q ys phi')))))
  :requires ((check_onepoint Q ctx xs ys phi phi') true)
  :conclusion (cl (= (Q xs phi) (Q ys phi')))
)

