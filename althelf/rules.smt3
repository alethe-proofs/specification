; TODO: other number types. Can the equality be flipped?
(declare-rule la_rw_eq ((t Real) (u Real))
  :args ((cl (= (= t u) (and (<= t u) (<= u t)))))
  :conclusion (cl (= (= t u) (and (<= t u) (<= u t))))
)

